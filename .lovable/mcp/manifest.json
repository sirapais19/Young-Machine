{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "young-machine-mcp",
      "version": "0.1.0",
      "title": "Young Machine Club MCP"
    },
    "tools": [
      {
        "name": "club_info",
        "title": "Club info",
        "description": "Get basic information about the Young Machine (YM) frisbee club.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_players",
        "title": "List players",
        "description": "List Young Machine club players with basic profile info.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_tournaments",
        "title": "List tournaments",
        "description": "List upcoming and past Young Machine tournaments.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by status.",
              "type": "string",
              "enum": [
                "upcoming",
                "past",
                "all"
              ]
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
